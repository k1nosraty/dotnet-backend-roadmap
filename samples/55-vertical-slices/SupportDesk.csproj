<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Verification.cs" />
    <Compile Include="AggregateChecks.cs" />
    <Compile Include="AdapterChecks.cs" />
    <Compile Include="MappingChecks.cs" />
    <Compile Include="Presentation/**/*.cs" />
    <Compile Include="Features/**/*.cs" />
    <ProjectReference Include="src/Domain/SupportDesk.Domain.csproj" />
    <ProjectReference Include="src/Application/SupportDesk.Application.csproj" />
    <ProjectReference Include="src/Infrastructure/SupportDesk.Infrastructure.csproj" />
  </ItemGroup>
</Project>
